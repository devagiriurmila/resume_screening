# Copy this file to .env and edit values as needed.
SECRET_KEY=change-me-to-a-long-random-string
# Full path to tesseract.exe if it is not on PATH (Windows example):
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional overrides
# DATABASE_PATH=database/screening.db
# MAX_FILE_MB=10
# REVIEW_THRESHOLD=50
# HIGH_MATCH_THRESHOLD=70
# KEEP_UPLOADED_FILES=false
# OCR_DPI=200
# OCR_MAX_PAGES=10
# PORT=5000
